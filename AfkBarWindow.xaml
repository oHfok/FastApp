<Window x:Class="FastApp.AfkBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FastApp — Away" ShowInTaskbar="False" ShowActivated="False"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="Manual"
        Topmost="True" Background="#D9363E" Height="30">

    <!--
        A flat strip flush with the physical top edge of the screen, not a
        floating card like the OSD: square corners are correct here, the
        same way a browser's "you are being recorded" banner or a title bar
        does not round itself off. Deliberately not theme-aware (unlike the
        OSD, which reworks its colours per theme): this is a screen-wide
        alert competing with whatever is behind it, not a piece of the app's
        own surface, so it stays one fixed alert red regardless of dark or
        light mode.

        Click-through and never-activating, set in code-behind the same way
        OsdWindow does it: a status strip is not a control, and it must
        never be the thing that steals focus from whatever you were doing
        right before FastApp decided you had stopped.
    -->
    <Grid>
        <TextBlock Text="AFK DETECTED"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontFamily="Consolas" FontWeight="Bold" FontSize="13"
                   Foreground="White">
            <TextBlock.Effect>
                <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.4" Color="Black"/>
            </TextBlock.Effect>
        </TextBlock>
    </Grid>
</Window>
