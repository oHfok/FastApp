<Window x:Class="FastApp.AutoLaunchProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Auto-Launch" Height="110" Width="380"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="NoResize" WindowStartupLocation="Manual">

    <!-- Same visual language as OsdWindow (background/border/corner radius/colors)
         so the two transient popups read as the same feature, not two different
         ones — this one is just centered instead of bottom-right, and carries
         more content (a counter line, a current-app line, a progress bar). -->
    <Border x:Name="ProgressBorder" Background="#E6101010" CornerRadius="10" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="22,16" Opacity="0">
        <StackPanel VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Apps24" FontSize="20" Foreground="#0078D7" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="TitleText" Text="Opening 1 of 10" FontSize="16" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="SubtitleText" Text="Starting: —" FontSize="12" Foreground="#999999" Margin="30,4,0,12"/>
            <ProgressBar x:Name="ProgressBarControl" Height="4" Minimum="0" Maximum="10" Value="1"
                         Background="#22FFFFFF" Foreground="#0078D7" BorderThickness="0"/>
        </StackPanel>
    </Border>
</Window>
