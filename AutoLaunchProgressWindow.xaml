<Window x:Class="FastApp.AutoLaunchProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Auto-Launch" Width="440" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="NoResize" WindowStartupLocation="Manual">

    <!--
        This used to say "Opening 3 of 10" in large type with the app name
        demoted to grey subtext under it, over a stock ProgressBar. The count
        was the headline and the only thing you actually wanted to know — what
        is starting, what has started, what is left — was either absent or the
        smallest thing on screen.

        It shows the plan instead: every app that is going to start, each with
        its own state. The whole list is known before the first one launches, so
        there was never a reason to reveal it one line at a time.

        Row colours are bound from the item rather than looked up as
        StaticResource inside the template. A mistyped resource key in a
        DataTemplate fails at render time, not at build time, and this window
        renders during login when nobody is watching for a crash dialog.
    -->
    <Border x:Name="ProgressBorder"
            Background="{StaticResource BrandOverlayBackground}"
            BorderBrush="{StaticResource BrandOverlayBorder}"
            BorderThickness="1"
            CornerRadius="20"
            Padding="24,20"
            Opacity="0">
        <StackPanel>

            <Grid Margin="0,0,0,12">
                <TextBlock x:Name="HeadingText" Text="STARTING YOUR APPS"
                           FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource BrandTextFaint}"
                           HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <TextBlock x:Name="CountText" Text=""
                           FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource BrandTextDim}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <!-- A pill track and a pill fill, sized in code. A stock ProgressBar
                 brings its own chrome and its own corners, and looked borrowed
                 from a different application. -->
            <Grid x:Name="ProgressTrack" Height="3" Margin="0,0,0,16">
                <Border CornerRadius="2" Background="{StaticResource BrandOverlayTrack}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="FillColumn" Width="0*"/>
                        <ColumnDefinition x:Name="RestColumn" Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="2" Background="{StaticResource BrandBrass}"/>
                </Grid>
            </Grid>

            <ItemsControl x:Name="RowList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding Marker}" Foreground="{Binding MarkerBrush}"
                                       FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{Binding NameBrush}"
                                       FontSize="14" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>

                            <TextBlock Grid.Column="2" Text="{Binding Detail}" Foreground="{Binding DetailBrush}"
                                       FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"
                                       Margin="12,0,0,0"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="MoreText" Visibility="Collapsed"
                       FontFamily="Consolas" FontSize="11"
                       Foreground="{StaticResource BrandTextFaint}"
                       Margin="20,1,0,0"/>

            <TextBlock x:Name="SummaryText" Visibility="Collapsed"
                       FontSize="15" Foreground="{StaticResource BrandText}"
                       TextWrapping="Wrap"/>

        </StackPanel>
    </Border>
</Window>
