<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The light half of the brand palette, merged over Brand.xaml when Windows
        is set to light. Only the keys whose meaning changes are here; anything
        absent keeps the value Brand.xaml gave it, which is the point of merging
        rather than duplicating the whole file.

        The same values as the light block in wwwroot/css/tokens.css, so every
        surface of the application agrees.
    -->

    <!-- The accent as text/marker on a light surface. -->
    <Color x:Key="BrandBrassColor">#3D5AFE</Color>
    <SolidColorBrush x:Key="BrandBrass" Color="{StaticResource BrandBrassColor}"/>
    <SolidColorBrush x:Key="BrandBrassDim" Color="#7F97FF"/>

    <SolidColorBrush x:Key="BrandAction" Color="#8B3FD9"/>

    <SolidColorBrush x:Key="BrandText" Color="#101828"/>
    <SolidColorBrush x:Key="BrandTextDim" Color="#475467"/>
    <SolidColorBrush x:Key="BrandTextFaint" Color="#667085"/>

    <!-- The overlays sit over whatever is on screen, so they stay nearly
         opaque; what changes is which way the wash goes. -->
    <SolidColorBrush x:Key="BrandOverlayBackground" Color="#F2FFFFFF"/>
    <SolidColorBrush x:Key="BrandOverlayBorder" Color="#26101828"/>
    <SolidColorBrush x:Key="BrandOverlayTrack" Color="#14101828"/>

    <SolidColorBrush x:Key="BrandTeal" Color="#0A7F72"/>
    <SolidColorBrush x:Key="BrandRose" Color="#D92D3A"/>

    <SolidColorBrush x:Key="BrandChipBackground" Color="#12101828"/>

</ResourceDictionary>
