<Window x:Class="FastApp.OsdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="OSD" Height="80" Width="320"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="NoResize" WindowStartupLocation="Manual">

    <Border x:Name="OsdBorder" Background="#E6101010" CornerRadius="8" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="20,0" Opacity="0" Margin="50,0,-50,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!-- We keep both icons here and toggle visibility to avoid version conflicts in C# -->
            <ui:SymbolIcon x:Name="ActionIcon" Symbol="Flash24" FontSize="24" Foreground="#FF8C00" Margin="0,0,15,0" Visibility="Collapsed"/>
            <ui:SymbolIcon x:Name="AppIcon" Symbol="Apps24" FontSize="24" Foreground="#0078D7" Margin="0,0,15,0" Visibility="Collapsed"/>

            <TextBlock x:Name="OsdText" Text="Macro Activated" FontSize="16" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>