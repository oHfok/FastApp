<Window x:Class="FastApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FastApp"
        Title="FastApp"
        Width="0" Height="0"
        WindowStyle="None"
        ShowInTaskbar="False"
        Visibility="Hidden"
        Icon="/Assets/app-icon.ico">

    <!-- This window has no interface any more. It used to be the whole app: a
         three-tab manager whose Statistics tab held nothing but a button that
         opened a browser. All of it now lives in the palette, which is built on
         the same design system as the web dashboard.

         What remains is a host. FastApp is a tray application, and this window
         is where the things that must outlive any view are owned: the tray icon,
         the low-level keyboard hook, the view model, the palette itself, and
         the session-ending handler that flushes tracking when Windows shuts
         down. It is never shown. -->

</Window>
