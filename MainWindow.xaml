<ui:FluentWindow x:Class="FastApp.MainWindow"
                 x:Name="RootWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:FastApp" 
                 Title="FastApp" Height="700" Width="950"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 Icon="/Assets/app-icon.ico">

    <Window.Resources>
        <local:PercentageConverter x:Key="PercentageToWidthConverter"/>
        <local:DietWidthConverter x:Key="DietWidthConverter"/>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <local:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <local:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Title="FastApp" Grid.Row="0" Icon="/Assets/app-icon.ico" />

        <TabControl Grid.Row="1" Margin="20,0,20,20" Background="Transparent" BorderThickness="0" SelectedIndex="{Binding SelectedTabIndex}">

            <!-- ========================================== -->
            <!-- TAB 1: APPLICATIONS -->
            <!-- ========================================== -->
            <TabItem Margin="0,0,0,0">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <ui:SymbolIcon Symbol="Apps24" FontSize="18" Margin="0,0,8,0"/>
                        <TextBlock Text="Applications" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="0,20,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- FIX: Define templates as Resources to prevent the WPF Event Compiler Bug -->
                    <Grid.Resources>

                        <!-- 1. COMPACT ROW TEMPLATE -->
                        <DataTemplate x:Key="CompactAppTemplate">
                            <ui:CardAction Command="{Binding DataContext.ExpandCompactAppCommand, ElementName=RootWindow}" CommandParameter="{Binding}">
                                <Grid Background="Transparent" Cursor="Hand" Height="26">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="⣿" Foreground="{StaticResource BrandTextFaint}" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                    <ui:SymbolIcon Grid.Column="1" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <ui:SymbolIcon.Style>
                                            <Style TargetType="ui:SymbolIcon">
                                                <Setter Property="Symbol" Value="Apps24"/>
                                                <Setter Property="Foreground" Value="{StaticResource BrandBrass}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAction}" Value="True">
                                                        <Setter Property="Symbol" Value="Flash24"/>
                                                        <Setter Property="Foreground" Value="{StaticResource BrandAction}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:SymbolIcon.Style>
                                    </ui:SymbolIcon>

                                    <TextBlock Grid.Column="2" Text="{Binding DisplayNamePrimary}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrandText}" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="3" Text="{Binding HotkeyDisplayText}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrandBrass}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                </Grid>
                            </ui:CardAction>
                        </DataTemplate>

                        <!-- 2. EXPANDED CARD TEMPLATE -->
                        <DataTemplate x:Key="ExpandedAppTemplate">
                            <ui:CardExpander IsExpanded="False">
                                <ui:CardExpander.Header>
                                    <!-- Use a fixed-width grid to ensure elements don't overlap -->
                                    <Grid Margin="0,8,0,8" Background="Transparent" Cursor="Hand">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <!-- Drag Handle -->
                                            <ColumnDefinition Width="Auto"/>
                                            <!-- Icon -->
                                            <ColumnDefinition Width="*"/>
                                            <!-- Name (Takes all remaining space) -->
                                            <ColumnDefinition Width="Auto"/>
                                            <!-- Hotkey Border -->
                                            <ColumnDefinition Width="Auto"/>
                                            <!-- Auto-Start Toggle -->
                                            <ColumnDefinition Width="Auto"/>
                                            <!-- Delete Button -->
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="⣿" Foreground="{StaticResource BrandTextFaint}" FontSize="20" VerticalAlignment="Center" Margin="0,0,15,0" ToolTip="Drag to reorder"/>

                                        <ui:SymbolIcon Grid.Column="1" FontSize="22" Margin="0,0,15,0" VerticalAlignment="Center">
                                            <ui:SymbolIcon.Style>
                                                <Style TargetType="ui:SymbolIcon">
                                                    <Setter Property="Symbol" Value="Apps24"/>
                                                    <Setter Property="Foreground" Value="{StaticResource BrandBrass}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAction}" Value="True">
                                                            <Setter Property="Symbol" Value="Flash24"/>
                                                            <Setter Property="Foreground" Value="{StaticResource BrandAction}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:SymbolIcon.Style>
                                        </ui:SymbolIcon>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,15,0">
                                            <TextBlock Text="{Binding DisplayNamePrimary}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource BrandText}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{StaticResource BrandTextDim}" Visibility="{Binding SubtitleVisibility}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <Border Grid.Column="3" Background="{StaticResource BrandChipBackground}" CornerRadius="4" Padding="10,4" Margin="0,0,20,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Keyboard24" FontSize="14" Foreground="{StaticResource BrandBrass}" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding HotkeyDisplayText}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrandBrass}" />
                                            </StackPanel>
                                        </Border>

                                        <ui:ToggleSwitch Grid.Column="4" IsChecked="{Binding LaunchOnStartup}" Content="Auto-Start" Visibility="{Binding AppSettingsVisibility}" VerticalAlignment="Center" Margin="0,0,20,0"/>

                                        <ui:Button Grid.Column="5" Content="Delete" Icon="Delete24" ToolTip="Remove App" Appearance="Danger" VerticalAlignment="Center" 
                   Command="{Binding ElementName=RootWindow, Path=DataContext.RemoveApplicationCommand}" 
                   CommandParameter="{Binding}"/>
                                    </Grid>
                                </ui:CardExpander.Header>

                                <StackPanel Margin="0,15,0,5">
                                    <Grid Margin="0,0,0,20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,30,0" Visibility="{Binding ActionSettingsVisibility}">
                                            <TextBlock Text="System Action Type" FontSize="12" Foreground="{StaticResource BrandTextFaint}" Margin="0,0,0,4"/>
                                            <ComboBox SelectedIndex="{Binding ActionSelectionIndex}" Width="220">
                                                <ComboBoxItem Content="Toggle System Mute"/>
                                                <ComboBoxItem Content="Center Active Window"/>
                                                <ComboBoxItem Content="Paste Custom Text"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Grid.Column="0" Margin="0,0,30,0" Visibility="{Binding AppSettingsVisibility}">
                                            <TextBlock Text="Executable Path" FontSize="12" Foreground="{StaticResource BrandTextFaint}" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding ExecutablePath}" FontSize="13" Foreground="{StaticResource BrandTextDim}" VerticalAlignment="Center" Margin="0,5,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Visibility="{Binding ShowTextPayload}">
                                            <TextBlock Text="Text to Paste" FontSize="12" Foreground="{StaticResource BrandTextFaint}" Margin="0,0,0,4"/>
                                            <ui:TextBox Text="{Binding ActionPayload, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Enter text snippet..." MinHeight="32" Margin="0,0,20,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Top">
                                            <TextBlock Text="Custom Display Name" FontSize="12" Foreground="{StaticResource BrandTextFaint}" Margin="0,0,0,4"/>
                                            <ui:TextBox Text="{Binding CustomName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="E.g. Panic Mute" MinHeight="32" Width="180"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,40,0">
                                            <TextBlock Text="Reassign Hotkey" FontSize="12" Foreground="{StaticResource BrandTextFaint}" Margin="0,0,0,8"/>
                                            <StackPanel Orientation="Horizontal">
                                                <ui:TextBox Text="{Binding HotkeyDisplayText}" IsReadOnly="True" GotFocus="HotkeyTextBox_GotFocus" PreviewKeyDown="HotkeyTextBox_PreviewKeyDown" PreviewKeyUp="HotkeyTextBox_PreviewKeyUp" MinHeight="32" Width="180" />
                                                <ui:Button Content="Clear" Icon="Dismiss24" Click="ClearHotkey_Click" ToolTip="Clear Hotkey" Margin="10,0,0,0" Appearance="Secondary"/>
                                            </StackPanel>
                                            <ui:ToggleSwitch IsChecked="{Binding SuppressHotkeyPassthrough}" Content="Don't pass through"
                                                             ToolTip="Stop the focused app from also receiving this key combination"
                                                             Margin="0,10,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="0,0,40,0" Visibility="{Binding AppSettingsVisibility}">
                                            <TextBlock Text="Daily Limit (Minutes)" FontSize="12" Foreground="{StaticResource BrandTextFaint}" Margin="0,0,0,8"/>
                                            <StackPanel Orientation="Horizontal">
                                                <ui:TextBox Text="{Binding DailyLimitText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="0 = No Limit" MinHeight="32" Width="120" IsEnabled="{Binding DataContext.CanEditDailyLimit, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                                                <ui:ToggleSwitch IsChecked="{Binding StrictFocusMode}" Content="Force Close" ToolTip="Kills the app automatically when limit is reached" Margin="15,0,0,0" IsEnabled="{Binding DataContext.CanEditDailyLimit, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                                            </StackPanel>
                                            <TextBlock Text="Locked once a Parental PIN is set — change it from the web dashboard instead." FontSize="10" Foreground="{StaticResource BrandTextFaint}" Margin="0,4,0,0" TextWrapping="Wrap" MaxWidth="240"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                            <TextBlock Text="Quick Stats" FontSize="12" Foreground="{StaticResource BrandTextFaint}" Margin="0,0,0,8"/>
                                            <StackPanel Orientation="Horizontal">
                                                <StackPanel Orientation="Horizontal" Visibility="{Binding AppSettingsVisibility}" Margin="0,0,25,0">
                                                    <ui:SymbolIcon Symbol="Clock24" Foreground="{StaticResource BrandBrass}" FontSize="16" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding TimeRunning, StringFormat='{}{0:hh\\:mm\\:ss}'}" Foreground="{StaticResource BrandText}" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="14"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Flash24" Foreground="{StaticResource BrandAction}" FontSize="16" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding HotkeyTriggerCount, StringFormat='{}Triggered {0}x'}" Foreground="{StaticResource BrandText}" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="14"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Auto-launch settings. Only shown for app
                                         entries; system actions have nothing to
                                         start. Launch order is the list order,
                                         which is already drag-reorderable. -->
                                    <Grid Margin="0,20,0,0" Visibility="{Binding AppSettingsVisibility}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,40,0">
                                            <TextBlock Text="Launch Arguments" FontSize="12" Foreground="{StaticResource BrandTextFaint}" Margin="0,0,0,8"/>
                                            <ui:TextBox Text="{Binding LaunchArguments, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="e.g. --profile work" MinHeight="32"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Startup Delay (Seconds)" FontSize="12" Foreground="{StaticResource BrandTextFaint}" Margin="0,0,0,8"/>
                                            <ui:TextBox Text="{Binding LaunchDelayText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="0" MinHeight="32" Width="120"/>
                                            <TextBlock Text="Waits this long before opening it at startup." FontSize="10" Foreground="{StaticResource BrandTextFaint}" Margin="0,4,0,0" TextWrapping="Wrap" MaxWidth="200"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </ui:CardExpander>
                        </DataTemplate>
                    </Grid.Resources>

                    <!-- Header Toolbar -->
                    <Grid Grid.Row="0" Margin="0,0,10,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ui:TextBox Grid.Column="0" Text="{Binding AppSearchText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Search your apps..." Icon="Search24" Width="250" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:ToggleSwitch Content="Compact View" IsChecked="{Binding IsCompactMode}" VerticalAlignment="Center" Margin="0,0,25,0"/>


                            <ui:Button Content="New Action" Icon="Lightning24" Appearance="Secondary" Command="{Binding AddCustomActionCommand}" Padding="15,6"  Margin="0,0,10,0"/>                            
                            <ui:Button Content="Browse Files" Icon="FolderOpen24" Appearance="Secondary" Command="{Binding AddCustomFileCommand}" Padding="15,6" Margin="0,0,10,0"/>
                            <ui:Button Content="Scan PC For Applications" Icon="SearchInfo24" Appearance="Primary" Command="{Binding AddApplicationCommand}" Padding="15,6" Margin="0,0,10,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- App List -->
                    <Grid Grid.Row="1">
                        <!-- First-run onboarding: nothing configured yet, so the list
                             below would otherwise just render as a blank panel with no
                             indication of what to do next. Only the count matters here
                             (ManagedApps, not the search-filtered view) — a search that
                             matches nothing has its own "no results" empty state inside
                             the ItemsControl below, and shouldn't also show this one. -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380"
                                    Visibility="{Binding ManagedApps.Count, Converter={StaticResource CountToVisibilityConverter}}">
                            <ui:SymbolIcon Symbol="AppsList24" FontSize="42" Foreground="{StaticResource BrandTextFaint}" HorizontalAlignment="Center"/>
                            <TextBlock Text="No apps tracked yet" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource BrandText}"
                                       HorizontalAlignment="Center" Margin="0,16,0,6"/>
                            <TextBlock Text="Scan your PC to find installed apps and start tracking your time automatically." FontSize="13" Foreground="{StaticResource BrandTextDim}"
                                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,20"/>
                            <ui:Button Content="Scan PC For Applications" Icon="SearchInfo24" Appearance="Primary" Command="{Binding AddApplicationCommand}"
                                       Padding="18,8" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ListBox ItemsSource="{Binding FilteredManagedApps}"
                                 Background="Transparent" BorderThickness="0" 
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 AllowDrop="True" 
                                 PreviewMouseLeftButtonDown="AppList_PreviewMouseLeftButtonDown"
                                 PreviewMouseMove="AppList_PreviewMouseMove"
                                 Drop="AppList_Drop">

                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,10,12"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <ContentControl Content="{Binding}">
                                        <ContentControl.Style>
                                            <Style TargetType="ContentControl">
                                                <!-- Bind safely to the resources we declared at the top -->
                                                <Setter Property="ContentTemplate" Value="{StaticResource ExpandedAppTemplate}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.IsCompactMode, ElementName=RootWindow}" Value="True">
                                                        <Setter Property="ContentTemplate" Value="{StaticResource CompactAppTemplate}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ContentControl.Style>
                                    </ContentControl>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>


            <!-- ========================================== -->
            <!-- TAB 2: STATISTICS (Web Redirect) -->
            <!-- ========================================== -->
            <TabItem DataContext="{Binding StatisticsVM}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <ui:SymbolIcon Symbol="DataBarHorizontal24" FontSize="18" Margin="0,0,8,0"/>
                        <TextBlock Text="Statistics" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>

                <Grid Background="Transparent">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-50,0,0">
                        <TextBlock Text="📊" FontSize="80" HorizontalAlignment="Center" Margin="0,0,0,20">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="{StaticResource BrandBrassColor}" BlurRadius="40" ShadowDepth="0" Opacity="0.6"/>
                            </TextBlock.Effect>
                        </TextBlock>

                        <TextBlock Text="Your Analytics Have Upgraded" 
                                   FontSize="28" FontWeight="Bold" Foreground="{StaticResource BrandText}" 
                                   HorizontalAlignment="Center" Margin="0,0,0,10"/>

                        <TextBlock Text="We've moved all charts, insights, and historical data to a brand new, lightning-fast web dashboard. Your Windows app is now purely dedicated to silent, efficient tracking." 
                                   FontSize="14" Foreground="{StaticResource BrandTextDim}" TextWrapping="Wrap" 
                                   TextAlignment="Center" MaxWidth="450" Margin="0,0,0,30" LineHeight="22"/>

                        <ui:Button Command="{Binding OpenWebDashboardCommand}" 
                                   Content="Open Web Dashboard  ↗" Icon="Globe24" Appearance="Primary" 
                                   HorizontalAlignment="Center" Padding="40,12" FontSize="15" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
            </TabItem>


            <!-- ========================================== -->
            <!-- TAB 3: SETTINGS -->
            <!-- ========================================== -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <ui:SymbolIcon Symbol="Settings24" FontSize="18" Margin="0,0,8,0"/>
                        <TextBlock Text="Settings" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="0,20,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="600" HorizontalAlignment="Left">

                            <TextBlock Text="System Behavior" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource BrandText}" Margin="0,0,0,15"/>

                            <ui:CardControl Margin="0,0,0,10" Padding="15">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Launch on Startup" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource BrandText}"/>
                                        <TextBlock Text="Automatically start FastApp silently in the background when Windows boots." Foreground="{StaticResource BrandTextDim}" FontSize="12" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch IsChecked="{Binding LaunchOnSystemStartup}" IsEnabled="{Binding IsStartupToggleBusy, Converter={StaticResource InverseBooleanConverter}}"/>
                            </ui:CardControl>

                            <!-- Only visible when another copy of FastApp owns the
                                 startup registration. The app used to correct this
                                 silently on every launch, which meant an unrequested
                                 UAC prompt and two copies overwriting each other. -->
                            <Border Margin="0,0,0,10" Padding="15" CornerRadius="8"
                                    Background="#14E8A33D" BorderBrush="{StaticResource BrandBrassDim}" BorderThickness="1"
                                    Visibility="{Binding HasStartupConflict, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Startup points at another copy" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource BrandText}"/>
                                        <TextBlock Text="{Binding StartupConflictText}" Foreground="{StaticResource BrandTextDim}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ui:Button Grid.Column="1" Content="Use this copy" Appearance="Secondary" VerticalAlignment="Center" Margin="12,0,0,0"
                                               Command="{Binding FixStartupRegistrationCommand}"
                                               IsEnabled="{Binding IsStartupToggleBusy, Converter={StaticResource InverseBooleanConverter}}"/>
                                </Grid>
                            </Border>

                            <ui:CardControl Margin="0,0,0,10" Padding="15">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Enable On-Screen Display (OSD)" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource BrandText}"/>
                                        <TextBlock Text="Show a small visual popup when a hotkey is successfully triggered." Foreground="{StaticResource BrandTextDim}" FontSize="12" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch IsChecked="{Binding EnableOsd}"/>
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,30" Padding="15">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Show Auto-Launch Progress" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource BrandText}"/>
                                        <TextBlock Text="Show a centered popup with live progress while startup apps are being opened." Foreground="{StaticResource BrandTextDim}" FontSize="12" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch IsChecked="{Binding ShowAutoLaunchProgress}"/>
                            </ui:CardControl>


                            <TextBlock Text="Notifications" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource BrandText}" Margin="0,0,0,15"/>

                            <ui:CardControl Margin="0,0,0,10" Padding="15">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Show Notifications" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource BrandText}"/>
                                        <TextBlock Text="Daily limit warnings and startup problems, as Windows notifications. Limits are still enforced when this is off." Foreground="{StaticResource BrandTextDim}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" MaxWidth="380"/>
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch IsChecked="{Binding NotificationsEnabled}"/>
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,10" Padding="15">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Quiet Hours" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource BrandText}"/>
                                        <TextBlock Text="Stay silent overnight. A window that crosses midnight is fine." Foreground="{StaticResource BrandTextDim}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" MaxWidth="380"/>
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch IsChecked="{Binding QuietHoursEnabled}"/>
                            </ui:CardControl>

                            <Grid Margin="0,0,0,30" HorizontalAlignment="Left"
                                  Visibility="{Binding QuietHoursEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                    <TextBlock Text="From" FontSize="12" Foreground="{StaticResource BrandTextFaint}" Margin="0,0,0,4"/>
                                    <ui:TextBox Text="{Binding QuietHoursFrom, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="22:00" MinHeight="32" Width="110"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Until" FontSize="12" Foreground="{StaticResource BrandTextFaint}" Margin="0,0,0,4"/>
                                    <ui:TextBox Text="{Binding QuietHoursTo, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="07:00" MinHeight="32" Width="110"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Web Server Status" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource BrandText}" Margin="0,0,0,15"/>

                            <ui:CardControl Margin="0,0,0,10" Padding="15">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Dashboard Port" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource BrandText}"/>
                                        <TextBlock Text="{Binding DashboardStatusText}" Foreground="{StaticResource BrandTextDim}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" MaxWidth="380"/>
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:Button Content="Open Browser" Icon="Globe24" Appearance="Secondary" Command="{Binding StatisticsVM.OpenWebDashboardCommand}"/>
                            </ui:CardControl>

                            <TextBlock Text="Application" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource BrandText}" Margin="0,15,0,15"/>

                            <ui:CardControl Margin="0,0,0,10" Padding="15">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="{Binding UpdateVersionText}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource BrandText}"/>
                                        <TextBlock Text="{Binding UpdateStatusText}" Foreground="{StaticResource BrandTextDim}" FontSize="12" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:Button Content="Check for Updates" Icon="ArrowSync24" Appearance="Secondary"
                                               Command="{Binding CheckForUpdatesCommand}" IsEnabled="{Binding IsCheckingForUpdates, Converter={StaticResource InverseBooleanConverter}}"
                                               Visibility="{Binding IsUpdateReadyToApply, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                                    <ui:Button Content="Restart to Update" Icon="ArrowClockwise24" Appearance="Primary"
                                               Command="{Binding ApplyPendingUpdateCommand}"
                                               Visibility="{Binding IsUpdateReadyToApply, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </StackPanel>
                            </ui:CardControl>

                            <!-- Rolling back. Hidden entirely when there is nothing to go
                                 back to (a fresh install, or offline) rather than showing
                                 an empty picker. -->
                            <ui:CardExpander Margin="0,0,0,10" IsExpanded="False"
                                             Visibility="{Binding HasRollbackVersions, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ui:CardExpander.Header>
                                    <StackPanel Margin="0,8,0,8">
                                        <TextBlock Text="Reinstall an Earlier Version" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource BrandText}"/>
                                        <TextBlock Text="Go back if a release causes trouble. Your data is backed up first."
                                                   Foreground="{StaticResource BrandTextDim}" FontSize="12" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </ui:CardExpander.Header>
                                <StackPanel Margin="0,4,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <ComboBox Width="150" ItemsSource="{Binding RollbackVersions}"
                                                  SelectedItem="{Binding SelectedRollbackVersion, Mode=TwoWay}"
                                                  IsEnabled="{Binding IsRollbackBusy, Converter={StaticResource InverseBooleanConverter}}"/>
                                        <ui:Button Content="Reinstall" Icon="ArrowUndo24" Appearance="Secondary" Margin="10,0,0,0"
                                                   Command="{Binding RollBackCommand}"
                                                   IsEnabled="{Binding IsRollbackBusy, Converter={StaticResource InverseBooleanConverter}}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding RollbackWarningText}" TextWrapping="Wrap" MaxWidth="420"
                                               Foreground="{StaticResource BrandAction}" FontSize="12" Margin="0,10,0,0"
                                               Visibility="{Binding HasRollbackWarning, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <TextBlock Text="{Binding RollbackStatusText}" TextWrapping="Wrap"
                                               Foreground="{StaticResource BrandTextDim}" FontSize="12" Margin="0,8,0,0"/>
                                </StackPanel>
                            </ui:CardExpander>

                            <!-- What changed in the version actually running. Hidden when
                                 the notes could not be fetched (offline, or a release with
                                 none recorded) rather than showing an empty card. The full
                                 history lives in the dashboard, which can render markdown. -->
                            <ui:CardExpander Margin="0,0,0,10" IsExpanded="False"
                                             Visibility="{Binding HasWhatsNew, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ui:CardExpander.Header>
                                    <StackPanel Margin="0,8,0,8">
                                        <TextBlock Text="What's New" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource BrandText}"/>
                                        <TextBlock Text="{Binding UpdateVersionText, StringFormat='Changes in {0}'}" Foreground="{StaticResource BrandTextDim}" FontSize="12" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </ui:CardExpander.Header>
                                <StackPanel Margin="0,4,0,8">
                                    <TextBlock Text="{Binding WhatsNewText}" TextWrapping="Wrap" LineHeight="19"
                                               Foreground="{StaticResource BrandTextDim}" FontSize="12"/>
                                    <ui:Button Content="Full history in dashboard  &#x2197;" Icon="Globe24" Appearance="Secondary"
                                               Command="{Binding StatisticsVM.OpenWebDashboardCommand}"
                                               HorizontalAlignment="Left" Margin="0,12,0,0"/>
                                </StackPanel>
                            </ui:CardExpander>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</ui:FluentWindow>